# Gear Up Gadgets - Environment Variables Template
# Copy this file to .env and fill in your actual credentials

# Gmail SMTP Credentials for Transactional Emails (Generate App Password in Google Account -> Security -> 2FA -> App Passwords)
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-16-character-app-password

# Application Server Settings
PORT=3000
NODE_ENV=production

# Cloud Database & Project Settings
FIREBASE_PROJECT_ID=gear-up-gadgets
